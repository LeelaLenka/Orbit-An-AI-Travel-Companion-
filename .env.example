# Copy to .env for local development. On Vercel, add these in Project Settings -> Environment Variables.

# MongoDB Atlas, e.g. mongodb+srv://USER:PASS@leela.xxxxx.mongodb.net/orbit?retryWrites=true&w=majority
# Leave empty locally to use a temporary in-memory store.
MONGODB_URI=

# Free key from https://aistudio.google.com -> Get API key. Leave empty to use sample (demo) answers.
GEMINI_API_KEY=
# Optional: a model ID from AI Studio. If it's missing or retired, Orbit falls back to gemini-flash-latest.
GEMINI_MODEL=

# Any long random text (32+ characters)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# AI requests allowed per user per day (protects your free Gemini quota)
AI_DAILY_LIMIT=30
